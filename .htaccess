DirectoryIndex index.html
Options -Indexes
RewriteEngine On

# ── Core pages ───────────────────────────────────────────────────────────────
RewriteRule ^about-us/?$ /about-us.html [R=301,L]
RewriteRule ^about/?$ /about-us.html [R=301,L]
RewriteRule ^services/?$ /services.html [R=301,L]
RewriteRule ^case-studies/?$ /case-studies.html [R=301,L]
RewriteRule ^contact/?$ /contact.html [R=301,L]
RewriteRule ^contact-us/?$ /contact.html [R=301,L]

# ── Service pages ─────────────────────────────────────────────────────────────
RewriteRule ^meta-ads-agency-karachi/?$ /meta-ads-agency-karachi.html [R=301,L]
RewriteRule ^shopify-development-karachi/?$ /shopify-development-karachi.html [R=301,L]
RewriteRule ^branding-agency-karachi/?$ /branding-agency-karachi.html [R=301,L]
RewriteRule ^creative-photography-karachi/?$ /creative-photography-karachi.html [R=301,L]

# ── Old WordPress pages ───────────────────────────────────────────────────────
RewriteRule ^our-approach/?$ /about-us.html [R=301,L]
RewriteRule ^our-story/?$ /about-us.html [R=301,L]
RewriteRule ^team/?$ /about-us.html [R=301,L]
RewriteRule ^portfolio-category/.*$ /case-studies.html [R=301,L]
RewriteRule ^portfolio/?$ /case-studies.html [R=301,L]
RewriteRule ^portfolio/.*$ /case-studies.html [R=301,L]
RewriteRule ^our-work/?$ /case-studies.html [R=301,L]
RewriteRule ^work/?$ /case-studies.html [R=301,L]
RewriteRule ^food-photography/?$ /creative-photography-karachi.html [R=301,L]
RewriteRule ^product-photography/?$ /creative-photography-karachi.html [R=301,L]
RewriteRule ^photography/?$ /creative-photography-karachi.html [R=301,L]
RewriteRule ^videography/?$ /creative-photography-karachi.html [R=301,L]
RewriteRule ^social-media/?$ /meta-ads-agency-karachi.html [R=301,L]
RewriteRule ^digital-marketing/?$ /meta-ads-agency-karachi.html [R=301,L]
RewriteRule ^facebook-ads/?$ /meta-ads-agency-karachi.html [R=301,L]
RewriteRule ^web-design/?$ /shopify-development-karachi.html [R=301,L]
RewriteRule ^web-development/?$ /shopify-development-karachi.html [R=301,L]
RewriteRule ^ecommerce/?$ /shopify-development-karachi.html [R=301,L]
RewriteRule ^shopify/?$ /shopify-development-karachi.html [R=301,L]
RewriteRule ^branding/?$ /branding-agency-karachi.html [R=301,L]
RewriteRule ^logo-design/?$ /branding-agency-karachi.html [R=301,L]
RewriteRule ^blog/?.*$ / [R=301,L]
RewriteRule ^blog$ / [R=301,L]

# ============================================================================
#  PERFORMANCE — caching + compression (added; does NOT affect redirects above)
# ============================================================================

# ---------- GZIP / Brotli compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/x-javascript application/json \
    application/xml image/svg+xml application/rss+xml \
    font/ttf font/otf font/woff font/woff2 application/vnd.ms-fontobject
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain \
    application/javascript application/json image/svg+xml font/woff2
</IfModule>

# ---------- Correct MIME types ----------
<IfModule mod_mime.c>
  AddType image/webp                 .webp
  AddType image/x-icon               .ico
  AddType font/woff2                 .woff2
  AddType application/javascript     .js
</IfModule>

# ---------- Browser caching (Expires) ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/png         "access plus 1 year"
  ExpiresByType image/jpeg        "access plus 1 year"
  ExpiresByType image/gif         "access plus 1 year"
  ExpiresByType image/svg+xml     "access plus 1 year"
  ExpiresByType image/x-icon      "access plus 1 year"
  ExpiresByType font/woff2        "access plus 1 year"
  ExpiresByType font/woff         "access plus 1 year"
  ExpiresByType text/css          "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html         "access plus 0 seconds"
</IfModule>

# ---------- Cache-Control headers ----------
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|gif|ico|svg|css|js|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header unset ETag
</IfModule>
FileETag None

# ---------- Keep-Alive ----------
<IfModule mod_headers.c>
  Header set Connection keep-alive
</IfModule>
